echo "-- pacman.conf for the install --"
cat /tmp/spxo-pacman.conf

# ------------------------------------------------------------------- 7 pacstrap
say "7. installing the base system (network + local Surface repo)"
# Core system + the Omarchy Hyprland stack (hyprland quickshell foot sddm uwsm
# come from the omarchy-base.packages list read below; the Qualcomm additions
# (linux-firmware-qcom, qcom-firmware-extract, systemd-ukify, vulkan-freedreno)
# come from omarchy-aarch64-qualcomm.packages).
CORE_PKGS="base base-devel sudo grub efibootmgr dosfstools arch-install-scripts \
networkmanager bluez-utils nano git $( [ "$LUKS" -eq 1 ] && echo cryptsetup )"
# shellcheck disable=SC2086
PKGS="$CORE_PKGS $(read_pkg_list "$PKG_LISTS/omarchy-base.packages" | tr '\n' ' ') \
$(read_pkg_list "$PKG_LISTS/omarchy-aarch64.packages" | tr '\n' ' ') \
$(read_pkg_list "$PKG_LISTS/omarchy-aarch64-qualcomm.packages" | tr '\n' ' ') \
linux-surface linux-surface-headers omarchy omarchy-keyring omarchy-settings"
echo "-- resolving every package against the configured repositories --"
pacman -Sp --print-format '%o' --config /tmp/spxo-pacman.conf \
  --cachedir "$TARGET/var/cache/pacman/pkg" $PKGS > /tmp/spxo-urls.txt \
  || { echo "-- resolution failed; pacman detail (debug run) --"
       pacman -Sp --debug --print-format '%o' --config /tmp/spxo-pacman.conf \
         --cachedir "$TARGET/var/cache/pacman/pkg" $PKGS >/dev/null 2>/tmp/spxo-res-debug.log \
         || true
       grep -Ei 'error|cannot|resolve|conflict|unmet|missing' /tmp/spxo-res-debug.log | grep -v 'debug: ' | head -40
       grep -Ei 'debug:.*(depend|resolve|missing|unmet|conflict)' /tmp/spxo-res-debug.log | head -40
       echo "-- last debug lines before the abort --"
       tail -25 /tmp/spxo-res-debug.log
       die "package resolution failed - a package in the set is unavailable"; }
MISSING=$(grep -c 'file://$TARGET' /tmp/spxo-urls.txt || true)
echo "   resolved $(grep -c . /tmp/spxo-urls.txt) packages; $(wc -l < /tmp/spxo-urls.txt | tr -d ' ') download URLs"
# shellcheck disable=SC2086
pacstrap -C /tmp/spxo-pacman.conf "$TARGET" $PKGS || die "pacstrap failed"

# Do not rely solely on package hooks: stage and verify the Surface kernel on the ESP.
say "7a. verify boot artifacts"
KERNEL_SOURCE=""
for candidate in "$TARGET"/usr/lib/modules/*/vmlinuz; do
  [ -f "$candidate" ] || continue
  pkgbase_file="${candidate%/vmlinuz}/pkgbase"
  [ -r "$pkgbase_file" ] || continue
  [ "$(tr -d '\n' < "$pkgbase_file")" = "linux-surface" ] || continue
  [ -z "$KERNEL_SOURCE" ] || die "multiple linux-surface kernel images found"
  KERNEL_SOURCE="$candidate"
done
[ -n "$KERNEL_SOURCE" ] || die "linux-surface kernel image missing from target"
install -D -m 0644 "$KERNEL_SOURCE" "$TARGET/boot/vmlinuz-linux-surface" \
  || die "could not stage the Surface kernel on the ESP"
[ -s "$TARGET/boot/dtb/linux-surface/qcom/sc8180x-surface-pro-x.dtb" ] \
  || die "Surface Pro X SQ2 device tree missing from the ESP"
echo "OK   Surface kernel staged; SQ2 DTB present on the ESP"

# -------------------------------------------------------------------- 8 fstab
say "8. fstab"
genfstab -U "$TARGET" >> "$TARGET/etc/fstab"
cat "$TARGET/etc/fstab"

# ------------------------------------------------------- 9 configure (chroot)
say "9. configuring the system"
cat > "$TARGET/root/spxo.conf" <<EOF
ROOT_UUID=$ROOT_UUID
LUKS=$LUKS
LUKS_UUID=$LUKS_UUID
CRYPTROOT=$CRYPTROOT
