cat > "$TARGET/root/spxo-configure.sh" <<'CHROOT'
#!/bin/bash
set -e
. /root/spxo.conf

echo "-- locale / time / hostname"
ln -sf "/usr/share/zoneinfo/${TIMEZONE_}" /etc/localtime
hwclock --systohc || true
echo "${LOCALE_} UTF-8" > /etc/locale.gen
locale-gen
echo "LANG=${LOCALE_}" > /etc/locale.conf
echo "${HOSTNAME_}" > /etc/hostname

echo "-- persistent journal (a failed boot's logs must survive the next one)"
mkdir -p /var/log/journal
systemd-tmpfiles --create --prefix /var/log/journal 2>/dev/null || true

echo "-- user + sudo"
id "${USERNAME_}" >/dev/null 2>&1 || useradd -m -G wheel -s /bin/bash "${USERNAME_}"
echo '%wheel ALL=(ALL:ALL) ALL' > /etc/sudoers.d/10-wheel
chmod 0440 /etc/sudoers.d/10-wheel
if command -v visudo >/dev/null 2>&1; then
  visudo -cf /etc/sudoers.d/10-wheel || echo "warn: visudo rejected the sudoers file"
else
  echo "warn: visudo absent - check /etc/sudoers.d/10-wheel by hand"
fi

echo "-- repositories: [omarchy] first, so 'omarchy update' can move the desktop"
# pacstrap installs the ALARM pacman.conf, which has no [omarchy] stanza. Without
# this the installed system cannot update Omarchy at all: every omarchy package
# is foreign, omarchy-channel-current answers unknown, and pacman -Syu aborts on
# omarchy-hyprland-titlebars' hyprland pin. pacman takes a package name from the
# first repo that carries it, so [omarchy] goes above [core]; the omarchy repo
# pins hyprland in a way that keeps the titlebars pin satisfied.
# One pass: drop any existing [omarchy] stanza (wherever pacstrap left it) and
# write a canonical one immediately above [core], so the channel is right AND
# the ordering is enforced.
awk -v server="https://pkgs.omarchy.org/${OMARCHY_CHANNEL}/aarch64" '
  /^\[omarchy\]/ { skip = 1; next }
  /^\[/          { skip = 0 }
  skip           { next }
  /^\[core\]/ && !inserted {
    print "[omarchy]"
    print "Server = " server
    print ""
    inserted = 1
  }
  { print }
  END { if (!inserted) exit 4 }
' /etc/pacman.conf > /etc/pacman.conf.spxo || { echo "pacman.conf has no [core] stanza"; exit 1; }
cat /etc/pacman.conf.spxo > /etc/pacman.conf
rm -f /etc/pacman.conf.spxo
grep -q '^\[omarchy\]' /etc/pacman.conf || { echo "[omarchy] stanza missing after the rewrite"; exit 1; }
echo "   [omarchy] -> https://pkgs.omarchy.org/${OMARCHY_CHANNEL}/aarch64 (first repo: $(awk '/^\[/{gsub(/[\[\]]/,""); print; exit}' /etc/pacman.conf))"

echo "-- services (sddm + the Hyprland session via uwsm; no GNOME login)"
systemctl enable NetworkManager
systemctl enable sddm
systemctl enable systemd-timesyncd

echo "-- mDNS + shell color pin (autologin deliberately NOT configured)"
mkdir -p /etc/sddm.conf.d
systemctl enable --now avahi-daemon 2>/dev/null || systemctl enable avahi-daemon

echo "-- Omarchy shell: no QtQuick import pin (upstream fix ships from 4.0.5)"
# omacom/omarchy#14548 was Qt 6.12's built-in QtQuick/Color singleton shadowing
# qs.Commons.Color. Older installers rewrote the bare QtQuick import to a pinned
# 6.11 import and dropped a post-update hook that re-applied it. Upstream fixed
# it properly in #14553 (palette refs qualified as Commons.Color) and every
# channel we install ships zero unqualified refs, so the pin is gone: it only
# froze the shell on older QML APIs. Do not reintroduce it.

echo "-- patch omarchy-pkg-add: AUR fallback for Omarchy menu installs"
# Upstream routes many Omarchy menu entries (VS Code, Zed, ChatGPT, Spotify,
# Dropbox, NordVPN, 1Password, LM Studio, T3 Code, OpenClaw, Hermes Desktop,
# ...) through omarchy-pkg-add, which runs a bare `pacman -S`. pacman only
# sees core/extra/alarm, so those entries fail with "error: target not found"
# (the menu's "cannot find the software"). The helper below sends sync-repo
# packages to pacman and AUR-only packages to yay. It stays applied across
# `omarchy update` two ways: a pacman Path hook (reinstall on package upgrade)
# and a post-update hook (reinstall after any update), both restoring the copy
# under /usr/local/share/omarchy-patches/.
mkdir -p /usr/local/share/omarchy-patches /etc/pacman.d/hooks
cat > /usr/local/share/omarchy-patches/omarchy-pkg-add <<'EOF3'
#!/bin/bash

# omarchy:summary=Install Arch packages if they are missing
# omarchy:args=<packages...>
# omarchy:examples=omarchy pkg add jq ripgrep
# omarchy:requires-sudo=true
#
# spx-omarchy patch: classify each requested package. Present in an official
# sync repo -> pacman. AUR and builds for aarch64/any -> yay. AUR but x86_64
# only (or missing) -> refuse with a clear message and alternatives, instead
# of letting yay start an x86_64 build on ARM. Upstream omarchy-pkg-add calls
# pacman for everything, so AUR-only menu entries fail with
# "error: target not found".

if omarchy-pkg-missing "$@"; then
  repo_pkgs=()
  aur_pkgs=()
  for pkg in "$@"; do
    if pacman -Si -- "$pkg" &>/dev/null; then
      repo_pkgs+=("$pkg")
    else
      aur_pkgs+=("$pkg")
    fi
  done

  rc=0
  if ((${#repo_pkgs[@]})); then
    if (( EUID == 0 )); then
      pacman -S --noconfirm --needed -- "${repo_pkgs[@]}" || exit 1
    else
      sudo pacman -S --noconfirm --needed -- "${repo_pkgs[@]}" || exit 1
    fi
  fi

  if ((${#aur_pkgs[@]})); then
    ok=()
    no=()
    for pkg in "${aur_pkgs[@]}"; do
      arch_line=$(yay -Gp "$pkg" 2>/dev/null | grep -m1 '^arch=' || true)
      case "$arch_line" in
        *aarch64*|*any*) ok+=("$pkg") ;;
        *) no+=("$pkg") ;;
      esac
    done

    if ((${#ok[@]})); then
      if (( EUID != 0 )) && command -v yay &>/dev/null; then
        yay -S --noconfirm --needed "${ok[@]}" || rc=1
      else
        echo -e "\033[31mError: ${ok[*]} needs the desktop user with yay installed.\033[0m" >&2
        rc=1
      fi
    fi

    if ((${#no[@]})); then
      echo -e "\033[31mNot available for this device (ARM64 / aarch64):\033[0m" >&2
      for pkg in "${no[@]}"; do
        echo "  - ${pkg}: no aarch64 build in the AUR (x86_64 only, or the package does not exist)" >&2
      done
      echo "  Try a Flatpak, the vendor's web app, or an aarch64-native package instead." >&2
      rc=1
    fi
  fi

  (( rc == 0 )) || exit "$rc"
fi

for pkg in "$@"; do
  # Secondary check to handle states where pacman doesn't actually register an error
  if ! pacman -Q -- "$pkg" &>/dev/null; then
    echo -e "\033[31mError: Package '$pkg' did not install\033[0m" >&2
    exit 1
  fi
done

exit 0
EOF3
chmod 0755 /usr/local/share/omarchy-patches/omarchy-pkg-add
install -m 0755 /usr/local/share/omarchy-patches/omarchy-pkg-add /usr/bin/omarchy-pkg-add
cat > /etc/pacman.d/hooks/90-omarchy-pkg-add-yay.hook <<'EOF3'
[Trigger]
Operation = Upgrade
Type = Path
Target = usr/bin/omarchy-pkg-add

[Action]
Description = Re-applying AUR (yay) fallback patch to omarchy-pkg-add (spx-omarchy)
When = PostTransaction
Exec = /usr/bin/install -m 0755 /usr/local/share/omarchy-patches/omarchy-pkg-add /usr/bin/omarchy-pkg-add
AbortOnFail = No
EOF3
UPATCH="${UHOME:-/home/${USERNAME_}}/.config/omarchy/hooks/post-update.d"
mkdir -p "$UPATCH"
cat > "$UPATCH/patch-omarchy-pkg-add" <<'EOF3'
#!/bin/bash
# omarchy update replaces /usr/bin/omarchy-pkg-add; re-apply the AUR (yay)
# fallback so the Omarchy menu keeps installing AUR-only apps.
sudo install -m 0755 /usr/local/share/omarchy-patches/omarchy-pkg-add /usr/bin/omarchy-pkg-add
EOF3
chmod 0755 "$UPATCH/patch-omarchy-pkg-add"
chown -R "${USERNAME_}:${USERNAME_}" "$UPATCH" 2>/dev/null || true

echo "-- mask the phantom TPM units (90s boot stall on this device)"
systemctl mask dev-tpm0.device dev-tpmrm0.device

echo "-- bluetooth public address"
if [ -n "${BT_ADDR_}" ]; then
cat > /etc/btaddr.conf <<EOF2
BT_ADDR=${BT_ADDR_}
EOF2
fi
cat > /usr/local/bin/btaddr.sh <<'EOF2'
#!/bin/sh
# A controller with NO BD address is not listed by `btmgmt info`, so we cannot wait
# for it to appear - we retry the set until it reports complete. Runs AFTER
# bluetooth.service. NEVER restart bluetoothd: that re-initialises hci0 and the QCA
# firmware download then fails (-110 / -84).
[ -r /etc/btaddr.conf ] || exit 0
. /etc/btaddr.conf
[ -n "${BT_ADDR:-}" ] || exit 0
i=0
while [ "$i" -lt 80 ]; do
  cur=$(btmgmt info 2>/dev/null | grep -oE '([0-9A-Fa-f]{2}:){5}[0-9A-Fa-f]{2}' | head -n1)
  [ "$cur" = "$BT_ADDR" ] && { echo "btaddr: already $BT_ADDR"; exit 0; }
  out=$(btmgmt --index 0 public-addr "$BT_ADDR" 2>&1)
  case "$out" in *complete*) echo "btaddr: set $BT_ADDR"; exit 0;; esac
  i=$((i + 1)); sleep 0.5
done
echo "btaddr: could not set the address after 40s" >&2
exit 0
EOF2
chmod 0755 /usr/local/bin/btaddr.sh
cat > /etc/systemd/system/btaddr.service <<'EOF2'
[Unit]
Description=Set Bluetooth public address (Surface Pro X / WCN399x)
After=bluetooth.service
Wants=bluetooth.service

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStart=/usr/local/bin/btaddr.sh
TimeoutStartSec=90

[Install]
WantedBy=multi-user.target
EOF2
systemctl enable btaddr.service

echo "-- GRUB defaults"
cat > /etc/default/grub <<'EOF2'
GRUB_DEFAULT=0
GRUB_TIMEOUT=6
GRUB_DISTRIBUTOR="Omarchy"
GRUB_CMDLINE_LINUX="clk_ignore_unused efi=novamap rootwait"
GRUB_PRELOAD_MODULES="part_gpt part_msdos"
GRUB_TIMEOUT_STYLE=menu
GRUB_TERMINAL=gfxterm
GRUB_GFXMODE="1920x1080,2560x1440,1920x1200,auto"
GRUB_GFXPAYLOAD_LINUX=keep
GRUB_DISABLE_RECOVERY=true
GRUB_DISABLE_SUBMENU=y
GRUB_DISABLE_OS_PROBER=true
GRUB_COLOR_NORMAL="light-gray/black"
GRUB_COLOR_HIGHLIGHT="white/blue"
EOF2

# LUKSROOT is computed HERE, in the chroot shell, BEFORE the heredoc.
# Regression 2026-10-16 (root cause of the LUKS first-boot dark screen):
# the if/else used to live INSIDE the heredoc, but the drop-in is executed
# by grub-mkconfig as `exec tail -n +3 $0` -- it only PRINTS itself, never
# evaluates anything. And $LUKSROOT in the unquoted heredoc expanded at
# generation time to EMPTY, so the emitted linux lines carried NO
# root=/cryptdevice= args: the kernel unlocked nothing and the boot died
# dark. Expansion must happen in this shell, before the heredoc.
if [ "$LUKS" = 1 ]; then
  LUKSROOT="cryptdevice=UUID=${LUKS_UUID}:cryptroot root=/dev/mapper/${CRYPTROOT}"
else
  LUKSROOT="root=UUID=${ROOT_UUID}"
fi
echo "-- the critical bit: the devicetree line (without it the kernel boots blind)"
cat > /etc/grub.d/09_surface_pro_x <<EOF2
#!/bin/sh
exec tail -n +3 \$0

menuentry 'Omarchy (Surface Pro X)' {
    search --no-floppy --file --set=root /vmlinuz-linux-surface
    linux /vmlinuz-linux-surface ${LUKSROOT} rw clk_ignore_unused efi=novamap rootwait consoleblank=0 loglevel=4
    initrd /initramfs-linux-surface.img
    devicetree /dtb/linux-surface/qcom/sc8180x-surface-pro-x.dtb
}

menuentry 'Omarchy (Surface Pro X) - silent boot' {
    search --no-floppy --file --set=root /vmlinuz-linux-surface
    linux /vmlinuz-linux-surface ${LUKSROOT} rw clk_ignore_unused efi=novamap rootwait consoleblank=0 quiet loglevel=3
    initrd /initramfs-linux-surface.img
    devicetree /dtb/linux-surface/qcom/sc8180x-surface-pro-x.dtb
}

menuentry 'Omarchy (Surface Pro X) - verbose, fallback initramfs' {
    search --no-floppy --file --set=root /vmlinuz-linux-surface
    linux /vmlinuz-linux-surface ${LUKSROOT} rw clk_ignore_unused efi=novamap rootwait consoleblank=0 loglevel=7
    initrd /initramfs-linux-surface-fallback.img
    devicetree /dtb/linux-surface/qcom/sc8180x-surface-pro-x.dtb
}
EOF2
chmod 0755 /etc/grub.d/09_surface_pro_x
# 10_linux would emit duplicate entries with no devicetree line
chmod -x /etc/grub.d/10_linux 2>/dev/null || true
# Content checks, NOT `sh -n`: only the first two lines are shell, the rest is
# GRUB menuentry syntax.
head -1 /etc/grub.d/09_surface_pro_x | grep -q '^#!/bin/sh' \
  || { echo "generated GRUB entry is missing its #!/bin/sh header"; exit 1; }
grep -q 'devicetree /dtb/linux-surface/qcom/sc8180x-surface-pro-x.dtb' /etc/grub.d/09_surface_pro_x \
  || { echo "generated GRUB entry has no devicetree line - refusing to continue"; exit 1; }
sh -n /usr/local/bin/btaddr.sh || { echo "generated btaddr.sh has a syntax error"; exit 1; }
echo "   generated GRUB entry has a devicetree line; btaddr.sh parses"

echo "-- Omarchy runtime layer"
if [ -x /usr/bin/omarchy ]; then
  echo "   omarchy runtime present"
else
  echo "   warn: /usr/bin/omarchy missing - the omarchy package may not have installed"
fi
# Enable the Hyprland session under sddm; uwsm wraps it when present.
if [ -f /usr/share/wayland-sessions/hyprland-uwsm.desktop ] || [ -f /usr/share/wayland-sessions/hyprland.desktop ]; then
  echo "   Hyprland session file present"
fi

echo "-- swapfile"
if [ ! -f /swapfile ]; then
  fallocate -l "${SWAP_MB}M" /swapfile || dd if=/dev/zero of=/swapfile bs=1M count="${SWAP_MB}"
  chmod 600 /swapfile
  mkswap /swapfile
fi
grep -q '^/swapfile' /etc/fstab || echo '/swapfile none swap defaults 0 0' >> /etc/fstab

echo "-- passwords (interactive)"
passwd
passwd "${USERNAME_}"

echo "-- initramfs"
if [ "$LUKS" = 1 ]; then
  # decrypt the root in early userspace; keyboard/keymap hooks let the Type
  # Cover type the passphrase (usbhid must be present in early userspace)
  # Regression 2026-10-16: Omarchy's default HOOKS are SYSTEMD-based
  # (base systemd ... sd-vconsole). Appending the legacy `encrypt` hook
  # does nothing under the systemd initramfs -- it is silently ignored and
  # no passphrase prompt ever appears. The classic encrypt hook REQUIRES
  # the classic udev-based hook set; rewrite the whole line, don't append.
  sed -i -E 's/^HOOKS=\(.*\)$/HOOKS=(base udev autodetect microcode modconf kms keyboard keymap block encrypt filesystems fsck)/' /etc/mkinitcpio.conf
  grep -q '^HOOKS=(base udev' /etc/mkinitcpio.conf || { echo "could not rewrite HOOKS"; exit 1; }
  grep -qE '^HOOKS=.* encrypt ' /etc/mkinitcpio.conf || { echo "could not add the encrypt hook"; exit 1; }
  # Guard must anchor on the LIVE HOOKS line only: the conf's comment
  # examples legitimately mention "systemd" ("#    HOOKS=(base systemd
  # ... sd-encrypt ...)") and a whole-file grep aborted the install
  # (regression 2026-10-16, second on-device run).
  grep -E '^HOOKS=' /etc/mkinitcpio.conf | grep -q 'systemd ' \
    && { echo "systemd hook still on the live HOOKS line - legacy encrypt hook would be ignored"; exit 1; }
  sed -i -E 's/^MODULES=\(\)$/MODULES=(xhci-hcd usbhid hid-generic hid-multitouch)/' /etc/mkinitcpio.conf
  grep MODULES /etc/mkinitcpio.conf | grep -q usbhid || { echo "could not add usbhid to MODULES"; exit 1; }
  echo "   mkinitcpio.conf: classic udev hook set + encrypt + usb-hid modules"
fi
mkinitcpio -P
CHROOT

chmod 0755 "$TARGET/root/spxo-configure.sh"
echo "-- syntax-checking the generated configuration script before running it --"
bash -n "$TARGET/root/spxo-configure.sh" || die "the generated chroot script has a syntax error (nothing was run)"
if ! chroot_run /bin/bash /root/spxo-configure.sh; then
  chroot_done
  echo "!!! the chroot configuration script failed - the failing step is the LAST -- marker above"
  sleep 2
  die "chroot configuration failed"
fi
chroot_done

# ------------------------------------------------- 9b MineGRUB theme (optional)
if [ -d "$(dirname "$KIT")/minegrub" ]; then
  say "9b. MineGRUB theme"
  mkdir -p "$TARGET/boot/grub/themes" "$TARGET/etc/default/grub.d"
  cp -r "$(dirname "$KIT")/minegrub" "$TARGET/boot/grub/themes/" \
    || die "copying the MineGRUB theme failed"
  printf 'GRUB_THEME=/boot/grub/themes/minegrub/theme.txt\nGRUB_GFXMODE=2880x1920x32,2560x1440x32,1920x1080x32,auto\n' \
    > "$TARGET/etc/default/grub.d/50-minegrub.cfg"
  echo "OK   MineGRUB theme staged; GRUB_THEME drop-in written"
else
  echo "NOTE no minegrub/ theme dir next to the kit - skipping the theme"
fi

# -------------------------------------------------------------------- 10 GRUB
say "10. GRUB"
echo "-- grub-install (arm64-efi, NEVER aarch64-efi)"
if [ "$LUKS" -eq 1 ]; then
chroot_run grub-install --target=arm64-efi \
  --efi-directory=/boot/efi --boot-directory=/boot --removable || { chroot_done; die "grub-install failed"; }
else
chroot_run grub-install --target=arm64-efi \
  --efi-directory=/boot --boot-directory=/boot --removable || { chroot_done; die "grub-install failed"; }
fi
echo "-- grub-mkconfig"
# The EFI-NVRAM/os-prober generators can hang inside a chroot (efibootmgr on a
# bind-mounted /sys) and only add menu clutter anyway; keep the custom entry.
chroot_run chmod -x /etc/grub.d/31_efi_bootnext /etc/grub.d/30_os-prober /etc/grub.d/20_linux_xen 2>/dev/null || true
echo "-- generating grub.cfg (bounded by timeout so it cannot hang the install)"
echo "-- the generated grub.cfg: menuentries and devicetree lines follow in the verification phase"
if ! chroot_run timeout 600 grub-mkconfig -o /boot/grub/grub.cfg 2>&1; then
  chroot_done
  echo "!!! grub-mkconfig failed or timed out - its output is above"
  sleep 2
  die "grub-mkconfig failed"
fi
chroot_done

# ----------------------------------------------------------------- 11 firmware
say "11. firmware"
mkdir -p "$TARGET/lib/firmware/updates"
cp -R "$FW/." "$TARGET/lib/firmware/updates/" || die "firmware copy failed"
echo "   $(find "$TARGET/lib/firmware/updates" -type f | wc -l | tr -d ' ') firmware files"

# ------------------------------------------------------------------- 12 verify
say "12. verification (fail closed)"
FAIL=0
chk() { if eval "$2"; then echo "OK   $1"; else echo "FAIL $1"; FAIL=1; fi; }

chk "devicetree line present in grub.cfg (THE critical check)" \
    "grep -q devicetree '$TARGET/boot/grub/grub.cfg'"
chk "grub.cfg references the new root UUID" \
    "grep -q '$ROOT_UUID' '$TARGET/boot/grub/grub.cfg'"
chk "menuentries generated" \
    "[ \"\$(grep -c '^menuentry' '$TARGET/boot/grub/grub.cfg')\" -ge 3 ]"
if [ "$LUKS" -eq 1 ]; then
  chk "LUKS header (luksDump reads the container)" \
      "cryptsetup luksDump '$NVME'p3 >/dev/null"
  chk "cryptdevice on a linux cmdline in grub.cfg" \
      "grep -E '^[[:space:]]*linux /vmlinuz.*cryptdevice=' '$TARGET/boot/grub/grub.cfg' >/dev/null"
  chk "root=/dev/mapper on a linux cmdline in grub.cfg" \
      "grep -E '^[[:space:]]*linux /vmlinuz.*root=/dev/mapper/' '$TARGET/boot/grub/grub.cfg' >/dev/null"
  chk "initramfs carries the encrypt hook config" \
      "grep -qE '^HOOKS=.*encrypt' '$TARGET/etc/mkinitcpio.conf'"
  chk "initramfs hook set is udev-based (systemd hook absent)" \
      "! grep -qE '^HOOKS=\\(.* systemd ' '$TARGET/etc/mkinitcpio.conf'"
  chk "BOOTAA64.EFI on the ESP" \
      "[ -f '$TARGET/boot/efi/EFI/BOOT/BOOTAA64.EFI' ]"
else
  chk "BOOTAA64.EFI on the ESP" \
      "[ -f '$TARGET/boot/EFI/BOOT/BOOTAA64.EFI' ]"
fi
chk "kernel image present" \
    "[ -f '$TARGET/boot/vmlinuz-linux-surface' ]"
chk "initramfs present" \
    "[ -f '$TARGET/boot/initramfs-linux-surface.img' ]"
chk "device tree on the ESP" \
    "[ -f '$TARGET/boot/dtb/linux-surface/qcom/sc8180x-surface-pro-x.dtb' ]"
chk "firmware copied" \
    "[ \"\$(find '$TARGET/lib/firmware/updates' -type f | wc -l)\" -ge 60 ]"
chk "fstab has root and /boot" \
    "[ \"\$(grep -cE '^(UUID=|/dev/)' '$TARGET/etc/fstab')\" -ge 2 ]"
chk "swap in fstab" \
    "grep -q '^/swapfile' '$TARGET/etc/fstab'"
chk "sudoers for wheel" \
    "[ -f '$TARGET/etc/sudoers.d/10-wheel' ]"
chk "btaddr unit enabled" \
    "[ -L '$TARGET/etc/systemd/system/multi-user.target.wants/btaddr.service' ]"
chk "TPM units masked" \
    "[ -L '$TARGET/etc/systemd/system/dev-tpm0.device' ]"
chk "sddm enabled" \
    "[ -L '$TARGET/etc/systemd/system/display-manager.service' ]"
chk "Hyprland session file present" \
    "[ -n \"\$(find '$TARGET/usr/share/wayland-sessions' -name 'hyprland*.desktop' 2>/dev/null)\" ]"
chk "Qualcomm firmware installed" \
    "[ -d '$TARGET/usr/lib/firmware/qcom' ]"
chk "omarchy runtime installed" \
    "[ -e '$TARGET/usr/bin/omarchy' ]"
chk "the target pacman.conf carries [omarchy] (without it the install cannot update)" \
    "grep -q '^\[omarchy\]' '$TARGET/etc/pacman.conf'"
chk "Surface kernel package installed" \
    "[ -d '$TARGET/usr/lib/modules' ] && find '$TARGET/usr/lib/modules' -maxdepth 1 -type d -name '6.*-surface*' | grep -q ."
[ "$FAIL" -eq 0 ] || fail_closed "one or more verification checks failed"

echo
echo "full grub.cfg menuentries:"
grep -nE '^menuentry|devicetree' "$TARGET/boot/grub/grub.cfg"

echo
sync
umount -R "$TARGET" 2>/dev/null || true

echo
if [ "$FAIL" -eq 0 ]; then
  echo "================ INSTALL COMPLETE ================"
  echo "All checks passed."
else
  echo "================ CHECKS FAILED ==================="
  echo "Do NOT assume this will boot. The report is at:"
  echo "  $OUT"
  echo "The disks are unmounted; the previous system is gone either way."
  exit 1
fi
echo
echo "Remove the stick and power on."
if [ "$LUKS" -eq 1 ]; then
  echo "LUKS: type the disk passphrase at every boot in early userspace."
fi
echo "REMEMBER: a cold power-on will die at the logo on this device."
echo "Use Volume Up + Power -> Boot Configuration -> Internal Storage."
echo
echo "report saved to: $OUT"