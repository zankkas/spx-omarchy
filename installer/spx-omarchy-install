#!/usr/bin/env bash
# spx-omarchy-install - install Omarchy (AArch64) on a Surface Pro X (SQ1/SQ2),
# keeping the proven Surface kernel/DTB/GRUB boot path.
#
# RUNS IN A LIVE USB ENVIRONMENT as root (the experimental Omarchy USB's live
# session, with the USB Wi-Fi dongle connected):
#
#   bash /path/to/spx-omarchy-install [--luks]   # dry run (default, no writes)
#   bash /path/to/spx-omarchy-install --apply [--luks]
#                                                # ERASES the target after typing
#                                                #   ERASE <target>;
#                                                # --luks encrypts root (LUKS2)
#
# Separate project from spx-install: this script never modifies the SanDisk
# recovery stick, the 512 GB data drive, or the Omarchy USB itself. The
# linux-surface packages and Surface firmware are read from the recovery kit
# (SPXO_KIT or a kit/ sibling of this script).
#
# Sources:
#   - Omarchy packages:  https://pkgs.omarchy.org/<channel>/aarch64 (unsigned DB,
#                        channel = SPXO_CHANNEL, default stable)
#   - Arch Linux ARM:    https://arm-mirror.omarchy.org/$arch/$repo (unsigned DB)
#   - Surface kernel:    kit packages (linux-surface (see docs/ for the version this was validated with)), local file repo
#
# The generic linux-aarch64 kernel and Omarchy's Limine boot path are NOT used.
set -u

# ----------------------------------------------------------------- configuration
HOSTNAME_=${SPXO_HOSTNAME:-surface-x}
USERNAME_=${SPXO_USERNAME:-$(id -un 2>/dev/null || echo user)}
TIMEZONE_=${SPXO_TIMEZONE:-Europe/Berlin}
LOCALE_=${SPXO_LOCALE:-en_US.UTF-8}
BT_ADDR_=${SPXO_BT_ADDR:-}
SWAP_MB=4096
ESP_MB=512
LBOOT_MB=768   # unencrypted /boot when --luks (ESP holds only GRUB)
CRYPTROOT=cryptroot
NVME="${SPXO_TARGET_DISK:-/dev/nvme0n1}"
TARGET=/target
KIT="${SPXO_KIT:-}"
OMARCHY_CHANNEL=${SPXO_CHANNEL:-stable}
case "$OMARCHY_CHANNEL" in
  stable|rc|edge) ;;
  *) echo "SPXO_CHANNEL must be stable, rc or edge (got '$OMARCHY_CHANNEL')" >&2; exit 2 ;;
esac
# stable is upstream's own default for new installs and the channel this repo's
# guide is validated against. edge tracks development builds plus the newest
# Arch packages and is only for people who can recover a broken system; this
# device has no snapshots to roll back to.
OMARCHY_REPO="https://pkgs.omarchy.org/$OMARCHY_CHANNEL/\$arch"
ALARM_MIRROR='https://arm-mirror.omarchy.org/$arch/$repo'
MODE="--dry-run"
MODE="--dry-run"; LUKS=0
[ "$#" -le 0 ] || MODE="$1"
[ "$#" -le 2 ] || { echo "usage: $0 [--dry-run|--apply] [--luks]" >&2; exit 2; }
case "${2:-}" in
  "") ;;
  --luks) LUKS=1 ;;
  *) echo "usage: $0 [--dry-run|--apply] [--luks]" >&2; exit 2 ;;
esac
case "$MODE" in
  --dry-run|--apply) ;;
  *) echo "usage: $0 [--dry-run|--apply]" >&2; exit 2 ;;
esac
if [ -n "${SPXO_TARGET_DISK:-}" ]; then
  case "$NVME" in
    /dev/loop*) ;;
    *) echo "SPXO_TARGET_DISK overrides are restricted to disposable loop devices" >&2; exit 2 ;;
  esac
fi

SELF=$(cd "$(dirname "$0")" 2>/dev/null && pwd)
# The Surface kit (linux-surface packages + firmware) is read-only input:
# SPXO_KIT, or a kit/ directory next to this script.
if [ -z "$KIT" ]; then
  for candidate in "$SELF/kit" "$(dirname "$SELF")/kit" "/run/usb/kit"; do
    if [ -d "$candidate/packages" ] && [ -d "$(dirname "$candidate")/firmware" ]; then
      KIT="$candidate"; break
    fi
  done
fi
FW=""
[ -n "$KIT" ] && FW="$(dirname "$KIT")/firmware"
PKG_LISTS="$KIT/omarchy-packages"
if [ ! -d "$PKG_LISTS" ] && [ -d "$SELF/omarchy-packages" ]; then
  PKG_LISTS="$SELF/omarchy-packages"
fi
OUT="$SELF/report-omarchy-install.txt"

[ "$(id -u)" -eq 0 ] || { echo "run me as root"; exit 1; }

say()  { printf '\n\033[1m== %s\033[0m\n' "$*"; }
die()  { printf '\n!!! %s\n' "$*" >&2; echo "ABORTED - no further actions will run; earlier target changes may have occurred." >&2
  # Leave no mounts behind: a leftover /target makes the next run fail with
  # "Device or resource busy".
  echo "!!! $*" >&2
  echo "================ ABORTED - see the console above for the exact error ===================" >> "$OUT" 2>/dev/null || true
  sleep 2  # let the tee flush the report tail before the stick gets pulled
  if [ -d "$TARGET" ] && mountpoint -q "$TARGET" 2>/dev/null; then
    echo "cleaning up: unmounting $TARGET" >&2
    umount -R "$TARGET" 2>/dev/null || true
  fi
  exit 1; }
fail_closed() { echo "FAIL $1" >&2; echo "================ CHECKS FAILED - DO NOT BOOT ASSUMING SUCCESS ===================" >&2; sleep 2; exit 1; }

BOUND=0
chroot_run() {
  # Always use explicit bind mounts. arch-chroot mounts a FRESH devtmpfs on
  # /dev, which carries /dev/dm-0 but NOT the /dev/mapper/<cryptroot> symlink
  # (that is a udev artifact of the live env's own /dev), grub-probe then
  # dies with "failed to get canonical path of /dev/mapper/cryptroot" and
  # grub-mkconfig aborts (found 2026-10-15 in the loop-device oracle).
  # A wholesale bind of the live env's /dev keeps /dev/mapper visible.
  for d in dev proc sys run; do
    umount -l "$TARGET/$d" 2>/dev/null || true
    mkdir -p "$TARGET/$d"
    mount --bind "/$d" "$TARGET/$d" || die "chroot bind of /$d failed"
    BOUND=1
  done
  [ -e "$TARGET/etc/resolv.conf" ] || : > "$TARGET/etc/resolv.conf"
  chroot "$TARGET" "$@"
}
chroot_done() {
  [ "$BOUND" = 1 ] || return 0
  for d in dev proc sys run; do umount -l "$TARGET/$d" 2>/dev/null; done
  BOUND=0
}

verify_manifest() {
  local dir="$1" label="$2"
  [ -f "$dir/MANIFEST.sha256" ] || die "$label manifest missing: $dir/MANIFEST.sha256"
  (cd "$dir" && sha256sum -c MANIFEST.sha256) || die "$label manifest verification failed"
}

TOOLS_TMP=""
cleanup_runtime_tools() {
  [ -n "$TOOLS_TMP" ] || return 0
  rm -f -- "$TOOLS_TMP/usr/bin/mkfs.fat" "$TOOLS_TMP/usr/bin/mkfs.vfat" \
    "$TOOLS_TMP/usr/bin/pacstrap" "$TOOLS_TMP/usr/bin/arch-chroot" "$TOOLS_TMP/usr/bin/genfstab"
  rmdir -- "$TOOLS_TMP/usr/bin" "$TOOLS_TMP/usr" "$TOOLS_TMP" 2>/dev/null || true
}
trap cleanup_runtime_tools EXIT

# The live environment may lack pacstrap/arch-chroot/genfstab and mkfs.vfat.
# Extract them from the kit's own packages into a temporary PATH prefix.
bootstrap_runtime_tools() {
  local dos_pkg="" install_pkg="" p
  if command -v mkfs.vfat >/dev/null 2>&1 && command -v pacstrap >/dev/null 2>&1 \
      && command -v arch-chroot >/dev/null 2>&1 && command -v genfstab >/dev/null 2>&1; then
    return 0
  fi
  command -v tar >/dev/null 2>&1 || die "tar is required to load the bundled recovery helpers"
  TOOLS_TMP=$(mktemp -d /run/spxo-tools.XXXXXX) || die "cannot create temporary helper directory"
  if ! command -v mkfs.vfat >/dev/null 2>&1; then
    for p in "$KIT"/packages/dosfstools-*.pkg.tar.*; do
      [ -f "$p" ] || continue
      case "$p" in *.sig) continue ;; esac
      dos_pkg="$p"; break
    done
    [ -n "$dos_pkg" ] || die "bundled dosfstools package is missing from the kit"
    tar -xf "$dos_pkg" -C "$TOOLS_TMP" usr/bin/mkfs.fat usr/bin/mkfs.vfat \
      || die "cannot extract bundled dosfstools helpers"
    [ -x "$TOOLS_TMP/usr/bin/mkfs.fat" ] || die "bundled mkfs.fat is missing"
    [ -e "$TOOLS_TMP/usr/bin/mkfs.vfat" ] || ln -s mkfs.fat "$TOOLS_TMP/usr/bin/mkfs.vfat"
  fi
  if ! command -v pacstrap >/dev/null 2>&1 || ! command -v arch-chroot >/dev/null 2>&1 \
      || ! command -v genfstab >/dev/null 2>&1; then
    for p in "$KIT"/packages/arch-install-scripts-*.pkg.tar.*; do
      [ -f "$p" ] || continue
      case "$p" in *.sig) continue ;; esac
      install_pkg="$p"; break
    done
    [ -n "$install_pkg" ] || die "bundled arch-install-scripts package is missing from the kit"
    tar -xf "$install_pkg" -C "$TOOLS_TMP" usr/bin/pacstrap usr/bin/arch-chroot usr/bin/genfstab \
      || die "cannot extract bundled Arch installation helpers"
  fi
  PATH="$TOOLS_TMP/usr/bin:$PATH"
  export PATH
}

# Omarchy package composition: base + aarch64 + aarch64-qualcomm, comments and
# blank lines stripped, exactly as omarchy-pkg-defaults composes them.
read_pkg_list() {
  [ "$#" -ge 1 ] || die "read_pkg_list needs at least one package list"
  local f
  for f in "$@"; do
    [ -f "$f" ] || die "package list missing: $f"
    grep -vE '^\s*(#|$)' "$f" | tr ' ' '\n' | grep -vE '^\s*(#|$)'
  done
}

if [ "$MODE" = "--apply" ]; then
  exec > >(tee "$OUT") 2>&1
fi
echo "==== spx-omarchy-install ($MODE) ===="
date
echo

command -v sha256sum >/dev/null 2>&1 || die "sha256sum is required for integrity checks"
[ -n "$KIT" ] || die "no Surface kit found (set SPXO_KIT or place a kit/ next to this script)"
[ -d "$FW" ] || die "no firmware/ found next to the kit ($FW) - refusing to build a system without it"
[ -d "$PKG_LISTS" ] || die "no omarchy-packages/ lists found at $PKG_LISTS"
verify_manifest "$KIT/packages" "package"
verify_manifest "$FW" "firmware"
bootstrap_runtime_tools

# Offline mode: the kit carries a pre-resolved package cache (pkg/ + sync DBs)
# with a sha256 manifest. When present, the install needs no network. The cache
# may be a directory (kit/omarchy-pkgcache/) or a single tarball
# (kit/omarchy-pkgcache.tar). The tar is NOT extracted at detection time:
# /run and /tmp are small tmpfs in the live environment, and writing hundreds
# of small files to the FAT stick is pathologically slow. It is extracted onto
# the freshly formatted ext4 target in phase 6b instead.
OFFLINE_DIR=""
OFFLINE_TAR=""
if [ -d "$KIT/omarchy-pkgcache/pkg" ] && [ -d "$KIT/omarchy-pkgcache/sync" ]; then
  OFFLINE_DIR="$KIT/omarchy-pkgcache"
  ( cd "$OFFLINE_DIR" && sha256sum -c MANIFEST.sha256 ) >/dev/null 2>&1 \
    || die "omarchy-pkgcache manifest verification failed"
elif [ -f "$KIT/omarchy-pkgcache.tar" ]; then
  OFFLINE_TAR="$KIT/omarchy-pkgcache.tar"
fi
OFFLINE=0
if [ -n "$OFFLINE_DIR" ] || [ -n "$OFFLINE_TAR" ]; then
  OFFLINE=1
fi

# -------------------------------------------------------------------- dry run
if [ "$MODE" = "--dry-run" ]; then
  cat <<EOF
spx-omarchy-install DRY RUN - no target disk, kit, or network files are modified.

  target disk      $NVME  (WILL BE COMPLETELY ERASED on a real run)
  ESP              ${ESP_MB} MiB fat32,   labelled EFI
  boot             $([ "$LUKS" -eq 1 ] && echo "${LBOOT_MB} MiB ext4, labelled boot (unencrypted)")
  root             $([ "$LUKS" -eq 1 ] && echo "LUKS2 (argon2id) as /dev/mapper/$CRYPTROOT, ext4 inside" || echo "remainder ext4,      labelled root")
  hostname         $HOSTNAME_
  user             $USERNAME_  (wheel + sudo)
  timezone         $TIMEZONE_
  locale           $LOCALE_
  swapfile         ${SWAP_MB} MiB at /swapfile
  bluetooth addr   $BT_ADDR_  (oneshot unit; never restart bluetoothd)

  Surface kit      $KIT  (read-only: linux-surface packages + firmware)
  package lists    $PKG_LISTS
    omarchy-base                    $(read_pkg_list "$PKG_LISTS/omarchy-base.packages" | wc -l | tr -d ' ') packages
    omarchy-aarch64                 $(read_pkg_list "$PKG_LISTS/omarchy-aarch64.packages" | wc -l | tr -d ' ') packages
    omarchy-aarch64-qualcomm        $(read_pkg_list "$PKG_LISTS/omarchy-aarch64-qualcomm.packages" | wc -l | tr -d ' ') packages
    core additions                  base, sudo, grub, linux-surface(+headers), networkmanager, bluez-utils, efibootmgr
    composed set                    $(read_pkg_list "$PKG_LISTS/omarchy-base.packages" "$PKG_LISTS/omarchy-aarch64.packages" "$PKG_LISTS/omarchy-aarch64-qualcomm.packages" | sort | tr '\n' ' ')

  repositories     [omarchy] $OMARCHY_REPO   (network, unsigned, channel $OMARCHY_CHANNEL)
                   [core]/[extra]/[alarm]/[aur] via $ALARM_MIRROR  (network, unsigned)
                   [surface] file repo built from the kit's linux-surface packages
  package source   $([ "$OFFLINE" -eq 1 ] && { [ -n "$OFFLINE_TAR" ] && echo "OFFLINE - omarchy-pkgcache.tar in the kit (extracted onto the target during install, no network needed)" || echo "OFFLINE - omarchy-pkgcache in the kit ($(ls "$OFFLINE_DIR/pkg" | wc -l | tr -d ' ') packages, no network needed)"; } || echo "ONLINE - fetched from the mirrors")
  kernel/boot      linux-surface + sc8180x-surface-pro-x.dtb + GRUB arm64-efi
                   (the generic Arm kernel and the Limine bootloader are not installed)
  desktop          the Omarchy Hyprland stack via sddm (no GNOME session)
  network          REQUIRED - packages come from the Omarchy/ALARM mirrors

  Phases on a real run:
    1 preflight (target refused if removable/USB/ambiguous)  2 confirm (ERASE <target>)
    3 partition   4 format   5 mount   6 surface repo from kit
    7 pacstrap (network + local surface repo)   8 boot-artifact verify
    9 fstab   10 configure (chroot)   11 GRUB   12 firmware   13 verify

  Use --apply to install; it requires typing ERASE $NVME.
EOF
  say "preflight (read-only)"
  [ -b "$NVME" ] && echo "OK   $NVME present" || echo "FAIL $NVME missing"
  echo "OK   kit present: $KIT"
  echo "OK   firmware present: $FW"
  for t in sfdisk mkfs.vfat mkfs.ext4 pacstrap repo-add arch-chroot genfstab \
           curl pacman lsblk tar sha256sum; do
    command -v "$t" >/dev/null 2>&1 && echo "OK   $t" || echo "MISS $t"
  done
  echo "NOTE grub-install is provided by the target grub package and runs inside the chroot."
  echo "NOTE network repos are NOT probed in a dry run; --apply checks them first."

  say "generated-script check (still touching nothing)"
  TD=$(mktemp -d) || TD="/tmp/spxo-check.$$"
  mkdir -p "$TD"
  awk '/^cat > "\$TARGET\/root\/spxo-configure\.sh" <<.CHROOT.$/{f=1;next} /^CHROOT$/{f=0} f' "$0" > "$TD/configure.sh"
  if [ -s "$TD/configure.sh" ]; then
    if bash -n "$TD/configure.sh" 2>"$TD/err"; then
      echo "OK   generated chroot script parses ($(wc -l < "$TD/configure.sh" | tr -d ' ') lines)"
    else
      echo "FAIL generated chroot script does NOT parse:"
      sed 's/^/     /' "$TD/err"
    fi
    # Extract the GRUB entry out of the generated configure script.
    awk '/^cat > \/etc\/grub.d\/09_surface_pro_x <<EOF2$/{f=1;next} /^EOF2$/{f=0} f' "$TD/configure.sh" \
      | sed 's/\${ROOT_UUID}/DUMMY-UUID-0000/g; s/\\\$0/$0/g' > "$TD/grubd.sh"
    if [ -s "$TD/grubd.sh" ]; then
      # Content checks, NOT sh -n: only the first two lines are shell.
      if head -1 "$TD/grubd.sh" | grep -q '^#!/bin/sh' && sed -n '2p' "$TD/grubd.sh" | grep -q 'exec tail'; then
        echo "OK   generated GRUB entry has the correct #!/bin/sh + exec tail header"
      else
        echo "FAIL generated GRUB entry header is wrong (first two lines):"
        head -2 "$TD/grubd.sh" | sed 's/^/     /'
      fi
      echo "     menuentries: $(grep -c '^menuentry' "$TD/grubd.sh")   devicetree lines: $(grep -c 'devicetree ' "$TD/grubd.sh")"
      grep -q 'devicetree /dtb/linux-surface/qcom/sc8180x-surface-pro-x.dtb' "$TD/grubd.sh" \
        && echo "OK   the devicetree line is present in the generated entry" \
        || echo "FAIL devicetree line missing from the generated entry"
      grep -q 'root=UUID=DUMMY-UUID-0000' "$TD/grubd.sh" \
        && echo "OK   the root UUID substitution renders correctly" \
        || echo "FAIL root UUID did not substitute into the entry"
    else
      echo "FAIL could not extract the generated GRUB entry"
    fi
  else
    echo "FAIL could not extract the generated chroot script"
  fi
  rm -rf "$TD"
  echo
  exit 0
fi

# ------------------------------------------------------------------- 1 preflight
say "1. preflight"
[ -b "$NVME" ] || die "$NVME not found - is the internal disk attached?"
DISK_TYPE=$(lsblk -dn -o TYPE "$NVME" 2>/dev/null | tr -d ' ')
DISK_TRAN=$(lsblk -dn -o TRAN "$NVME" 2>/dev/null | tr -d ' ')
DISK_MODEL=$(lsblk -dn -o MODEL "$NVME" 2>/dev/null)
if [ -n "${SPXO_TARGET_DISK:-}" ]; then
  [ "$DISK_TYPE" = "loop" ] || die "SPXO_TARGET_DISK must resolve to a loop device"
else
  [ "$DISK_TYPE" = "disk" ] || die "default target is not a whole disk"
  # Fail closed on removable/USB media: the internal NVMe reports TRAN=nvme.
  case "$DISK_TRAN" in
    nvme) ;;
    *) die "target $NVME transport is '$DISK_TRAN' (model: $DISK_MODEL), not the internal NVMe - refusing a removable/USB/ambiguous target" ;;
  esac
  case "$DISK_MODEL" in
    *SanDisk*|*Rainbow*) die "target $NVME looks like a USB stick ($DISK_MODEL) - refusing" ;;
  esac
fi
echo "OK   target $NVME (type=$DISK_TYPE transport=$DISK_TRAN model=$DISK_MODEL)"

say "1a. network reachability (install needs the mirrors)"
if [ "$OFFLINE" -eq 1 ]; then
  echo "OFFLINE MODE - omarchy-pkgcache found in the kit; skipping mirror checks"
else
check_repo() {
  local url="$1" label="$2"
  curl -fsSL --max-time 30 -o /dev/null "$url" \
    || die "cannot reach $label ($url) - connect the USB Wi-Fi dongle and retry"
  echo "OK   $label reachable"
}
check_repo "https://pkgs.omarchy.org/$OMARCHY_CHANNEL/aarch64/omarchy.db" "Omarchy $OMARCHY_CHANNEL aarch64 repo"
check_repo "https://arm-mirror.omarchy.org/aarch64/core/core.db" "ALARM mirror core"
fi

for t in sfdisk mkfs.vfat mkfs.ext4 repo-add tar sha256sum pacstrap arch-chroot genfstab curl $([ "$LUKS" -eq 1 ] && echo cryptsetup); do
  command -v "$t" >/dev/null 2>&1 || die "required tool missing: $t (dosfstools provides mkfs.vfat)"
done
[ -d /sys/firmware/efi ] || echo "warn: not booted via EFI - efibootmgr-era tools may misbehave"
echo "OK   all tools present"
lsblk -o PATH,TYPE,SIZE,TRAN,VENDOR,MODEL,FSTYPE,LABEL "$NVME"
echo
echo "kit: $KIT (read-only)"
echo

# --------------------------------------------------------------------- 2 confirm
say "2. confirmation"
cat <<EOF
This will DESTROY everything on $NVME:

    $(lsblk -dn -o PATH,TYPE,SIZE,VENDOR,MODEL,FSTYPE,LABEL "$NVME" 2>/dev/null)

Type exactly:  ERASE $NVME
EOF
read -r ANSWER
[ "$ANSWER" = "ERASE $NVME" ] || die "confirmation did not match - aborted"

# ------------------------------------------------------------------ 3 partition
say "3. partitioning (sfdisk; NOT parted)"
wipefs -a "$NVME" || true
sgdisk --zap-all "$NVME" 2>/dev/null || true
cat > /tmp/spxo-sfdisk.txt <<EOF
label: gpt
start=2048, size=$((ESP_MB * 2048)), type=C12A7328-F81F-11D2-BA4B-00A0C93EC93B, name="EFI"
EOF
if [ "$LUKS" -eq 1 ]; then
  cat >> /tmp/spxo-sfdisk.txt <<EOF
size=$((LBOOT_MB * 2048)), type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name="boot"
type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name="cryptroot"
EOF
else
  cat >> /tmp/spxo-sfdisk.txt <<EOF
type=0FC63DAF-8483-4772-8E79-3D69D8477DE4, name="root"
EOF
fi
sfdisk "$NVME" < /tmp/spxo-sfdisk.txt || die "sfdisk failed"
partprobe "$NVME" 2>/dev/null || true
sleep 2
[ -b "${NVME}p1" ] || die "partition 1 did not appear"
[ -b "${NVME}p2" ] || die "partition 2 did not appear"
[ "$LUKS" -eq 0 ] || [ -b "${NVME}p3" ] || die "partition 3 did not appear"
lsblk -o NAME,SIZE,FSTYPE "$NVME" 2>/dev/null || lsblk -o NAME,SIZE,FSTYPE "$NVME"

# --------------------------------------------------------------------- 4 format
say "4. formatting"
mkfs.vfat -F32 -n EFI "${NVME}p1" || die "mkfs.vfat failed"
if [ "$LUKS" -eq 1 ]; then
  mkfs.ext4 -F -L boot "${NVME}p2"   || die "mkfs.ext4 for /boot failed"
  say "LUKS: formatting the encrypted root (you will be asked for a passphrase twice)"
  cryptsetup --batch-mode --type luks2 --pbkdf argon2id luksFormat "${NVME}p3" \
    || die "luksFormat failed"
  cryptsetup open "${NVME}p3" "$CRYPTROOT" || die "cryptsetup open failed"
  [ -e "/dev/mapper/$CRYPTROOT" ] || die "the decrypted mapper device never appeared"
  mkfs.ext4 -F -L root "/dev/mapper/$CRYPTROOT" || die "mkfs.ext4 on the mapper failed"
  LUKS_UUID=$(blkid -s UUID -o value "${NVME}p3" 2>/dev/null)
  [ -n "$LUKS_UUID" ] || LUKS_UUID=$(blkid -s UUID -o value "${NVME}p3")
  [ -n "$LUKS_UUID" ] || die "could not read the LUKS container UUID"
  echo "LUKS container UUID: $LUKS_UUID"
  ROOT_UUID=$(blkid -s UUID -o value "/dev/mapper/$CRYPTROOT" 2>/dev/null)
  [ -n "$ROOT_UUID" ] || ROOT_UUID="unknown-${CRYPTROOT}"
else
  mkfs.ext4 -F -L root "${NVME}p2"   || die "mkfs.ext4 failed"
  ROOT_UUID=$(blkid -s UUID -o value "${NVME}p2")
  [ -n "$ROOT_UUID" ] || die "could not read the new root UUID"
  LUKS_UUID=""
fi
echo "new root UUID: $ROOT_UUID"

# ---------------------------------------------------------------------- 5 mount
say "5. mounting"
mkdir -p "$TARGET"
if [ "$LUKS" -eq 1 ]; then
  mount "/dev/mapper/$CRYPTROOT" "$TARGET" || die "mount the decrypted root failed"
  LBOOT=$(readlink -f "${NVME}p2")
  mkdir -p "$TARGET/boot"
  mount "$LBOOT" "$TARGET/boot" || die "mount /boot failed"
  ESP_DEV=$(readlink -f "${NVME}p1")
  mkdir -p "$TARGET/boot/efi"
  mount "$ESP_DEV" "$TARGET/boot/efi" || die "mount ESP at /boot/efi failed"
else
  mount "${NVME}p2" "$TARGET" || die "mount root failed"
  mkdir -p "$TARGET/boot"
  mount "${NVME}p1" "$TARGET/boot" || die "mount ESP failed"
fi
if [ "$LUKS" -eq 1 ]; then
  ESP_SOURCE=$(findmnt -n -o SOURCE --target "$TARGET/boot/efi" 2>/dev/null)
  ESP_EXPECTED=$(readlink -f "${NVME}p1")
  [ "$ESP_SOURCE" = "$ESP_EXPECTED" ] || die "the expected ESP is not mounted at $TARGET/boot/efi"
  findmnt -no SOURCE,TARGET "$TARGET" "$TARGET/boot/efi"
else
  ESP_SOURCE=$(findmnt -n -o SOURCE --target "$TARGET/boot" 2>/dev/null)
  ESP_EXPECTED=$(readlink -f "${NVME}p1")
  [ "$ESP_SOURCE" = "$ESP_EXPECTED" ] || die "the expected ESP is not mounted at $TARGET/boot"
  findmnt -no SOURCE,TARGET "$TARGET" "$TARGET/boot"
fi

# ---------------------------------------------------- 6 surface repo from kit
say "6. building the local Surface package repository (from the read-only kit)"
mkdir -p "$TARGET/var/cache/pacman/pkg"
cp -f "$KIT"/packages/*.pkg.tar.* "$TARGET/var/cache/pacman/pkg/" 2>/dev/null || true
( cd "$TARGET/var/cache/pacman/pkg" && repo-add -q surface.db.tar.gz \
    linux-surface-*.pkg.tar.* linux-surface-headers-*.pkg.tar.* ) \
  || die "repo-add failed for the Surface packages"
echo "OK   [surface] file repo built from the kit packages"

if [ "$OFFLINE" -eq 1 ]; then
  say "6b. loading the offline Omarchy package cache"
  if [ -n "$OFFLINE_TAR" ]; then
    echo "-- extracting the package cache onto the target (one-time) --"
    rm -rf "$TARGET/spxo-cache"
    mkdir -p "$TARGET/spxo-cache"
    tar -xf "$OFFLINE_TAR" -C "$TARGET/spxo-cache" \
      || die "cannot extract kit/omarchy-pkgcache.tar"
    ( cd "$TARGET/spxo-cache" && sha256sum -c MANIFEST.sha256 ) \
      || die "omarchy-pkgcache manifest verification failed"
    OFFLINE_DIR="$TARGET/spxo-cache"
  fi
  echo "-- moving packages into the target cache --"
  mv -f "$OFFLINE_DIR"/pkg/*.pkg.tar.* "$TARGET/var/cache/pacman/pkg/" \
    || die "moving the offline package cache failed"
  echo "   $(ls "$TARGET/var/cache/pacman/pkg" | wc -l | tr -d ' ') cached entries"
  echo "-- placing repository databases for pacstrap --"
  mkdir -p /var/lib/pacman/sync "$TARGET/var/lib/pacman/sync"
  # The [surface] repo database was built on the target in phase 6; pacman
  # resolves against the host sync dir, so register it there too.
  cp -f "$TARGET/var/cache/pacman/pkg/surface.db.tar.gz" /var/lib/pacman/sync/surface.db \
    || die "could not register the Surface repo database"
  cp -f "$OFFLINE_DIR"/sync/*.db /var/lib/pacman/sync/ \
    || die "copying sync databases to the live host failed"
  cp -f "$OFFLINE_DIR"/sync/*.db "$TARGET/var/lib/pacman/sync/" \
    || die "copying sync databases to the target failed"
  echo "   $(ls "$TARGET/var/lib/pacman/sync" | wc -l | tr -d ' ') repository databases placed"
  # pacstrap always runs pacman -Sy (refresh DBs). Make that fetch work with
  # no network: serve every repo from the local cache dir, where each DB is
  # placed under its transfer name (<repo>.db).
  echo "-- staging repo databases for the offline -Sy fetch --"
  cp -f "$OFFLINE_DIR"/sync/*.db "$TARGET/var/cache/pacman/pkg/" \
    || die "staging repo databases for offline pacstrap failed"
  # repo-add may leave surface.db as a symlink to the tarball; replace it with
  # a real file so the file:// fetch and the copy cannot collide.
  rm -f "$TARGET/var/cache/pacman/pkg/surface.db"
  cat "$TARGET/var/cache/pacman/pkg/surface.db.tar.gz" > "$TARGET/var/cache/pacman/pkg/surface.db" \
    || die "staging the surface database failed"
  [ -n "$OFFLINE_TAR" ] && rm -rf "$OFFLINE_DIR"
else
  echo "ONLINE MODE - packages will be fetched from the mirrors"
fi

OMARCHY_SERVER="https://pkgs.omarchy.org/$OMARCHY_CHANNEL/\$arch"
ALARM_SERVER='https://arm-mirror.omarchy.org/$arch/$repo'
if [ "$OFFLINE" -eq 1 ]; then
  # All repos resolve from the local cache dir; the DBs are staged there as
  # <repo>.db, so pacstrap's pacman -Sy fetches them over file:// with no
  # network. Packages are already in CacheDir.
  OMARCHY_SERVER="file://$TARGET/var/cache/pacman/pkg"
  ALARM_SERVER="file://$TARGET/var/cache/pacman/pkg"
fi

cat > /tmp/spxo-pacman.conf <<EOF
[options]
Architecture = aarch64
SigLevel = Never
HoldPkg = pacman glibc
CacheDir = $TARGET/var/cache/pacman/pkg

[surface]
Server = file://$TARGET/var/cache/pacman/pkg

[omarchy]
Server = $OMARCHY_SERVER

[core]
Server = $ALARM_SERVER

[extra]
Server = $ALARM_SERVER

[alarm]
Server = $ALARM_SERVER

[aur]
Server = $ALARM_SERVER
